DATABASE_URL=postgresql://hroshi:hroshi@localhost:5442/hroshi
PORT=4300
TZ=Europe/Madrid

# Every spelling of your name as banks write it, comma-separated (either word order matches).
# A payee that is exactly your name is a transfer between your own accounts.
OWNER_NAMES=

# Monobank personal token (api.monobank.ua). Never commit it.
MONO_TOKEN=

# Enable Banking (Revolut). The private key file is the one downloaded when the app was registered.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_KEY_PATH=./secrets/enable-banking.pem
# Must match a redirect URL registered on the Enable Banking app.
ENABLE_BANKING_REDIRECT_URL=http://localhost:4300/api/connections/revolut/callback
# Check the exact name and country with: pnpm --filter @hroshi/server cli eb:aspsps ES
ENABLE_BANKING_ASPSP_NAME=Revolut
ENABLE_BANKING_ASPSP_COUNTRY=ES

# Binance read-only key: no trading, no withdrawals, IP-restricted.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# IBKR Flex Web Service.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# Weekly digest: create a bot with @BotFather, send it /start, then `pnpm --filter @hroshi/server cli telegram:chats`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Splitwise: the `_splitwise_session` and `user_credentials` cookies of a browser signed in to splitwise.com.
# They act as the owner; copy fresh ones once the sync starts failing with 401.
SPLITWISE_SESSION=
SPLITWISE_USER_CREDENTIALS=
