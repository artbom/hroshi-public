{
  "name": "hroshi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @hroshi/server --filter @hroshi/web dev",
    "build": "pnpm --filter @hroshi/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @hroshi/server db:migrate",
    "db:generate": "pnpm --filter @hroshi/server db:generate",
    "seed": "pnpm --filter @hroshi/server cli seed"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
